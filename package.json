{
  "name": "@camcima/finita",
  "version": "3.0.0",
  "description": "A full-featured finite state machine library for TypeScript",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc --project tsconfig.test.json && eslint src/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit",
    "security:secrets": "gitleaks detect --no-banner",
    "release": "release-it",
    "prepublishOnly": "pnpm run build && pnpm run lint && pnpm test && npm pack --dry-run",
    "prepare": "lefthook install"
  },
  "keywords": [
    "statemachine",
    "state machine",
    "fsm",
    "status",
    "process"
  ],
  "author": "camcima (https://github.com/camcima)",
  "contributors": [
    "metabor (https://github.com/metabor)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/finita.git"
  },
  "homepage": "https://github.com/camcima/finita",
  "bugs": {
    "url": "https://github.com/camcima/finita/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "undici": ">=6.24.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.4"
  }
}
